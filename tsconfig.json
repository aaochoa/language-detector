{
    "compilerOptions": {
        "target": "ES2020",
        "types": ["node", "mocha", "chai"],
        "module": "commonjs",
        "lib": ["ES2020"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "allowJs": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "dist-test", "scripts", "test", "data", "models"]
}
